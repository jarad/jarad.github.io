 \[ \begin{array}{rl@{\qquad}ll}
 Y_t &= \theta_t + v_t &v_t&\ind N_m(0,V) \\
 \theta_t &= \theta_{t-1}+w_t & w_t&\ind N_p(0,W) \\
 p(\theta_0) &= N(m_0,C_0)
 \end{array} \]
 
\vspace{0.2in}

MCMC Scheme:
\begin{itemize}
\item Sample $p(\theta_{0:T}|\ldots)$ using FFBS
\item Sample $p(V,W|\ldots)$ 
\end{itemize}
}

