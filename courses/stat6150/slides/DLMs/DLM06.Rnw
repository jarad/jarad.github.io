\[ \begin{array}{rl} E[V|y_{1:T}] &= \phantom{1e-5}\left[ \begin{array}{cccc}
86 &(1) & 1026 &(23) \\
&& 59340 &(807)
\end{array} \right]
\\
\\
E[W_\mu|y_{1:T}] &= 1e-5\left[ \begin{array}{cccc}
