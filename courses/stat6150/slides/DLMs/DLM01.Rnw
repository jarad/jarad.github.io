 Y_t &= \theta_t + v_t &v_t &\ind N_1(0,V) \\
 \theta_t &= \theta_{t-1}+w_t & w_t &\ind N_1(0,W) \\
 &&\theta_0 &\sim N_1(m_0,C_0)
 \end{array} \]

