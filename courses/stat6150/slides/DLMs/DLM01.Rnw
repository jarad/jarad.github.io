\frame{\frametitle{Local level model}
\setkeys{Gin}{width=\textwidth}
  \[ \begin{array}{rl@{\qquad}l}
 Y_t &= \theta_t + v_t &v_t\ind N(0,V) \\
 \theta_t &= \theta_{t-1}+w_t & w_t\ind N(0,W) \\
 p(\theta_0) &= N(m_0,C_0)
 \end{array} \]

