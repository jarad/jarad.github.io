stock_returns_long <- stock_returns |>
  tidyr::pivot_longer(-date,
                      names_to  = "stock",
                      values_to = "return") |>
  mutate(
    stock = factor(stock, 
                   levels = c("CITCRP","IBM","MOBIL",
                              "WEYER","MARKET","RKFREE"))
  )

ggplot(stock_returns_long,
       aes(date, return)) + 
  geom_line() + 
  facet_wrap(~ stock, dir = "v") +
  labs(
    y = 'Monthly Returns'
  )
@
\end{frame}



